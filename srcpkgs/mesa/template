build_options="wayland"
build_options_default="wayland"

# only use llvmpipe on targets where it's supported and reliable
# especially on big endian it's all kinds of broken, and e.g. on
# 32-bit powerpc it does not work at all, so fall back to softpipe
case "$XBPS_TARGET_MACHINE" in
	i686*|x86_64*|aarch64*|ppc64le*|arm*|riscv64*)
		_have_llvmpipe=yes
		;;
esac

# Set subpackages manually to set proper rdeps in 32bit pkgs.
subpackages="mesa-libgallium libgbm libgbm-devel"

# Replace old mesa pkgs, superseded by libglvnd.
replaces="libGL>=10_1<19.2.5_2 libEGL>=10_1<19.2.5_2 libGLES>=10_1<19.2.5_2"

# Driver configuration
# Check for correctness on major mesa version updates
# Particularly, check if any new worthwhile drivers were added

# softpipe always present
_gallium_drivers=" -Dgallium-drivers=softpipe"
_vulkan_drivers=" -Dvulkan-drivers="

# amd and nvidia drivers on all platforms except where it makes no sense
# amd implicitly enables clover opencl, also enable hwdec and virgl too
case "$XBPS_TARGET_MACHINE" in
	armv5*|mips*) ;;
	*)
		_have_nv=yes
		_have_amd=yes
		_have_hwdec=yes
		_have_virgl=yes
		;;
esac

# x86 additionally gets intel, vmware and gallium nine
# aarch64 also gets vmware for VMware Fusion on Apple Silicon
# arm gets its own drivers (for mali, tegra etc.)
case "$XBPS_TARGET_MACHINE" in
	i686*|x86_64*)
		_have_intel=yes
		_have_vmware=yes
		;;
	aarch64*)
		_have_arm=yes
		_have_vmware=yes
		;;
	armv[67]*)
		_have_arm=yes
		;;
esac

# Direct3D 12 for Hyper-V GPU-P / WSLg. This relies on additional
# closed-source drivers which are only available on 64-bit glibc.
case "$XBPS_TARGET_MACHINE" in
	aarch64|x86_64)
		_have_d3d12=yes
		;;
esac

if [ "$XBPS_TARGET_LIBC" = musl ]; then
	# Requires execinfo, missing on musl
	_have_d3d12=
fi

_gallium_drivers+="$(vopt_if nine ,nine)"
if [ -n "$_have_llvmpipe" ]; then
	_gallium_drivers+=",llvmpipe"
fi
if [ -n "$_have_intel" ]; then
	_gallium_drivers+=",crocus,iris"
	_vulkan_drivers+=",intel,intel_hasvk"
fi
if [ -n "$_have_amd" ]; then
	_gallium_drivers+=",r300,r600,radeonsi"
	_vulkan_drivers+=",amd"
fi
if [ -n "$_have_nv" ]; then
	_gallium_drivers+=",nouveau"
	_vulkan_drivers+=",nouveau"
fi
if [ -n "$_have_vmware" ]; then
	_gallium_drivers+=",svga"
fi
if [ -n "$_have_arm" ]; then
	_gallium_drivers+=",v3d,vc4,freedreno,etnaviv,tegra,lima,panfrost,d3d12,zink"
	_vulkan_drivers+=",broadcom,freedreno,panfrost"
fi
if [ -n "$_have_d3d12" ]; then
	_gallium_drivers+=",d3d12"
	_vulkan_drivers+=",microsoft-experimental"
fi
if [ -n "$_have_hwdec" ]; then
	configure_args+=" -Dvideo-codecs=all"
fi
if [ -n "$_have_virgl" ]; then
	_gallium_drivers+=",virgl"
	_vulkan_drivers+=",virtio"
fi

configure_args+=" -Dgallium-drivers=${_gallium_drivers#,} -Dvulkan-drivers=${_vulkan_drivers#,}"

if [ -z "$CHROOT_READY" ]; then
	configure_args+=" -Dandroid-libbacktrace=disabled"
fi

pre_configure() {
	if [ "$XBPS_TARGET_MACHINE" = "x86_64-musl" ]; then
		vsed -i '/#include <sys\/types.h>/a #include <sys\/sysmacros.h>' \
			src/gallium/drivers/nouveau/nv30/nv30_screen.c \
			src/gallium/drivers/nouveau/nvc0/nvc0_screen.c
	fi
}

post_install() {
	# Not part of any subpkg
	rm -f "${DESTDIR}"/usr/lib/libglapi.so
	vlicense docs/license.rst
}

libglvnd-devel_package() {
	short_desc+=" - vendor neutral GL dispatch library (development files)"
	pkg_install() {
		vmove usr/lib/libGL.so
	}
}

mesa-dri_package() {
	short_desc+=" - DRI driver"
	depends="libglvnd>=${version}_${revision}"
	pkg_install() {
		vmove "usr/lib/dri"
		vmove "usr/lib/d3d"
	}
}

mesa-vdpau_package() {
	short_desc+=" - Gallium VDPAU state tracker"
	if [ -n "$_have_hwdec" ]; then
		depends="libglvnd>=${version}_${revision}"
		pkg_install() {
			vmove usr/lib/vdpau
		}
	fi
}

mesa-vaapi_package() {
	short_desc+=" - Gallium VAAPI state tracker"
	if [ -n "$_have_hwdec" ]; then
		depends="libglvnd>=${version}_${revision}"
		pkg_install() {
			vmove usr/lib/dri/*_drv_video.so
		}
	fi
}

mesa-opencl_package() {
	short_desc+=" - Clover OpenCL state tracker"
	if [ -n "$_have_amd" ]; then
		depends="libglvnd>=${version}_${revision}"
		pkg_install() {
			vmove usr/lib/gallium-pipe
			vmove usr/lib/libMesaOpenCL.so*
		}
	fi
}

mesa-demos_package() {
	short_desc="Mesa demos"
	depends="MesaLib>=${version}_${revision}"
	pkg_install() {
		vmove usr/bin
	}
}

libgbm_package() {
	short_desc="Generic buffer management API - runtime"
	pkg_install() {
		vmove "usr/lib/libgbm.so.*"
	}
}

libgbm-devel_package() {
	short_desc="Generic buffer management API - development files"
	depends="libgbm-${sourcepkg}>=${version}_${revision} libdrm-devel>=${_libdrm_version}"
	pkg_install() {
		vmove usr/include/gbm.h
		vmove usr/lib/libgbm.so
		vmove usr/lib/pkgconfig/gbm.pc
	}
}

mesa-libgallium_package() {
	short_desc+=" - shared gallium code"
	pkg_install() {
		vmove usr/lib/libgallium-*
	}
}

mesa-vulkan-overlay-layer_package() {
	short_desc+=" - Vulkan overlay layer"
	if [ -n "$_vulkan_drivers" ]; then
		depends="libglvnd>=${version}_${revision}"
		pkg_install() {
			vmove usr/share/vulkan/explicit_layer.d/VkLayer_MESA_overlay.json
			vmove usr/lib/libVkLayer_MESA_overlay.so
		}
	fi
}

if [ -n "$_have_intel" ]; then
	mesa-vulkan-intel_package() {
		short_desc+=" - Intel Vulkan driver"
		depends="libglvnd>=${version}_${revision}"
		pkg_install() {
			vmove usr/share/vulkan/icd.d/intel_icd*.json
			vmove usr/share/vulkan/icd.d/intel_hasvk_icd*.json
			vmove "usr/lib/libvulkan_intel*.so"
			vmove "usr/lib/libvulkan_intel_hasvk*.so"
		}
	}
fi

if [ -n "$_have_amd" ]; then
	mesa-vulkan-radeon_package() {
		short_desc+=" - AMD Vulkan driver"
		depends="libglvnd>=${version}_${revision}"
		pkg_install() {
			vmove usr/share/vulkan/icd.d/radeon_icd*.json
			vmove "usr/lib/libvulkan_radeon.so"
		}
	}
fi

if [ -n "$_have_nv" ]; then
	mesa-vulkan-nouveau_package() {
		short_desc+=" - NVIDIA Vulkan driver (NVK)"
		depends="libglvnd>=${version}_${revision}"
		pkg_install() {
			vmove usr/share/vulkan/icd.d/nouveau_icd*.json
			vmove "usr/lib/libvulkan_nouveau.so"
		}
	}
fi

if [ -n "$_have_arm" ]; then
	mesa-vulkan-freedreno_package() {
		short_desc+=" - Qualcomm Adreno Vulkan driver"
		depends="libglvnd>=${version}_${revision}"
		pkg_install() {
			vmove usr/share/vulkan/icd.d/freedreno_icd*.json
			vmove "usr/lib/libvulkan_freedreno.so"
		}
	}
	mesa-vulkan-broadcom_package() {
		short_desc+=" - Broadcom Vulkan driver"
		depends="libglvnd>=${version}_${revision}"
		pkg_install() {
			vmove usr/share/vulkan/icd.d/broadcom_icd*.json
			vmove "usr/lib/libvulkan_broadcom.so"
		}
	}
	mesa-vulkan-panfrost_package() {
		short_desc+=" - Panfrost (Mali) Vulkan driver"
		depends="libglvnd>=${version}_${revision}"
		pkg_install() {
			vmove usr/share/vulkan/icd.d/panfrost_icd*.json
			vmove "usr/lib/libvulkan_panfrost.so"
		}
	}
fi

if [ -n "$_have_d3d12" ]; then
	mesa-vulkan-microsoft-experimental_package() {
		short_desc+=" - Microsoft Vulkan driver"
		depends="libglvnd>=${version}_${revision}"
		pkg_install() {
			vmove usr/share/vulkan/icd.d/microsoft_icd*.json
			vmove "usr/lib/libvulkan_microsoft.so"
		}
	}
fi
